{
  "display_information": {
    "name": "Cast Operations",
    "description": "The Complete Open-Source Observability Platform",
    "background_color": "#000000",
    "long_description": "Cast Operations is a comprehensive solution for monitoring and managing your online services. Whether you need to check the availability of your website, dashboard, API, or any other online resource, Cast Operations can alert your team when downtime happens and keep your customers informed with a status page. Cast Operations also helps you handle incidents, set up on-call rotations, run tests, secure your services, analyze logs, track performance, and debug errors."
  },

  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Cast Operations",
      "always_online": true
    },
    "shortcuts": [
      {
        "name": "Create Scheduled Event",
        "type": "global",
        "callback_id": "/maintenance",
        "description": "Create a new scheduled event in Cast Operations"
      },
      {
        "name": "Create New Incident",
        "type": "global",
        "callback_id": "/incident",
        "description": "Creates a new incident in Cast Operations"
      }
    ],
    "slash_commands": [
      {
        "command": "/incident",
        "url": "{{SERVER_URL}}/api/slack/interactive",
        "description": "Create a new Incident in Cast Operations",
        "usage_hint": "[incident title]",
        "should_escape": false
      },
      {
        "command": "/maintenance",
        "url": "{{SERVER_URL}}/api/slack/interactive",
        "description": "Create a new Scheduled Maintenance in Cast Operations",
        "usage_hint": "[maintenance title]",
        "should_escape": false
      },
      {
        "command": "/cast-operations",
        "url": "{{SERVER_URL}}/api/slack/command",
        "description": "Ask Cast Operations AI about your logs, traces, metrics, incidents and monitors",
        "usage_hint": "ask which monitors are down?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["{{SERVER_URL}}/api/slack/auth"],
    "scopes": {
      "user": ["users:read"],
      "bot": [
        "commands",
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "channels:manage",
        "channels:read",
        "channels:write.invites",
        "channels:write.topic",
        "chat:write",
        "users:read",
        "groups:read",
        "groups:write",
        "groups:history",
        "im:read",
        "im:write",
        "im:history",
        "mpim:read",
        "mpim:write",
        "mpim:history",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "{{SERVER_URL}}/api/slack/interactive",
      "message_menu_options_url": "{{SERVER_URL}}/api/slack/options-load"
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "request_url": "{{SERVER_URL}}/api/slack/events",
      "bot_events": [
        "reaction_added",
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups",
        "message.mpim"
      ]
    }
  }
}
